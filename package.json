{
  "name": "agentic-tasks",
  "version": "0.3.0",
  "description": "Task boards where people and agents claim and finish work.",
  "keywords": [
    "tasks",
    "kanban",
    "todo",
    "project-management",
    "agents",
    "mcp",
    "cli",
    "collaboration"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-tasks.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-tasks",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "bin": {
    "agentic-tasks": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup && node scripts/build-ui.mjs",
    "prepack": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "ci:local": "npm run build && npm run typecheck && npm test && npm run test:e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-identity": "^0.4.0",
    "hono": "^4.13.14",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "agentic-design": "^0.1.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.155.0"
  }
}
