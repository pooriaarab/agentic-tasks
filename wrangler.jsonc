{
  // The Worker reads a bearer credential from the D1 store. For local dev only,
  // TASKS_UNSAFE_LOCAL_TEST_AUTH=1 trusts principal headers on loopback requests.
  // Never set it in production.
  //
  // Worker for the /api/v1/tasks HTTP API. State lives in the D1 database bound
  // as DB, so every Worker instance sees the same tasks and claims.
  //
  // Create the database in the EU, then put its id below. The location cannot
  // change later:
  //   wrangler d1 create agentic-tasks --location weur
  //   wrangler d1 migrations apply DB --remote
  // TASKS_REGION is a claim that you make about where the database lives. The
  // Worker answers 503 until it is "eu" or "us". The store also refuses a query
  // that D1 reports as served outside that region.
  "name": "agentic-tasks",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  // The shared adapters use Node built-ins such as Buffer.
  "compatibility_flags": ["nodejs_compat"],
  // No telemetry from any wrangler command in this project.
  "send_metrics": false,
  "vars": { "TASKS_REGION": "eu" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentic-tasks",
      // Local dev ignores this id. Replace it with the id that d1 create printed.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
